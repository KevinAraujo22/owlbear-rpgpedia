{
  "manifest_version": 3,
  "name": "RPGpédia → Owlbear",
  "version": "1.0.0",
  "description": "Envia as rolagens das suas fichas do rpgpedia.com para a extensão \"Rolagens RPGpédia\" do Owlbear Rodeo.",
  "permissions": ["storage"],
  "action": {
    "default_title": "RPGpédia → Owlbear",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://rpgpedia.com/*", "https://www.rpgpedia.com/*"],
      "js": ["rpgpedia-page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://rpgpedia.com/*", "https://www.rpgpedia.com/*"],
      "js": ["rpgpedia-relay.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kevinaraujo22.github.io/owlbear-rpgpedia/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["owlbear-relay.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
